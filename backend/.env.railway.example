# Railway → your backend service → Variables → "Raw Editor" → paste this, then fill in the blanks.
# (Real values stay in Railway only — never commit them.)

APP_NAME="Event Reservation"
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # copy the APP_KEY line from your local backend\.env
APP_URL=            # your Railway address, e.g. https://reservation-backend.up.railway.app

# Aiven MySQL (Overview page)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=reservation_system
DB_USERNAME=avnadmin
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=certs/ca.pem   # put Aiven's ca.pem in backend\certs\

# no sessions/cache/jobs tables in import.sql → use files / run now
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr

# Gmail (same as your local .env)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=   # Gmail App Password
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Event Reservation"
